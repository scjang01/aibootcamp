# ---- DB ----
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASS=your-db-password
DB_CHARSET=utf8mb4

# ---- 앱 ----
APP_DEBUG=false
SESSION_SECURE=false
SESSION_NAME=TAROTSESSID

# ---- LiteLLM ----
USE_MOCK=true
LITELLM_BASE=http://litellm:4000
LITELLM_KEY=sk-your-virtual-key
LITELLM_MODEL=HCX-005
LITELLM_TIMEOUT=20
